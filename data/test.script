CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.CONCERT_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.TICKET_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.USER_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE MEMORY TABLE PUBLIC.ARTISTE(AGE INTEGER NOT NULL,CONCERT_ID INTEGER,ID INTEGER NOT NULL PRIMARY KEY,GENRE VARCHAR(255),NATIONALITE VARCHAR(255),NOM VARCHAR(255),PRENOM VARCHAR(255),UNIQUE(CONCERT_ID))
CREATE MEMORY TABLE PUBLIC.CLIENT(AGE INTEGER NOT NULL,ID INTEGER NOT NULL PRIMARY KEY,TICKET_ID INTEGER,COMPTE_BANCAIRE VARCHAR(255),GENRE VARCHAR(255),NOM VARCHAR(255),PRENOM VARCHAR(255),UNIQUE(TICKET_ID))
CREATE MEMORY TABLE PUBLIC.CONCERT(ID INTEGER NOT NULL PRIMARY KEY,NOMBRE_PLACE INTEGER NOT NULL,POPULARITE INTEGER NOT NULL,DATE VARCHAR(255),DESCRIPTION VARCHAR(255),GENRE_MUSICALE VARCHAR(255),LIEU VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.CONCERT_ARTISTE(CONCERT_ID INTEGER NOT NULL,ARTISTE_ID INTEGER NOT NULL,UNIQUE(ARTISTE_ID),CONSTRAINT FKLAG8GARGV5IESV5N7KTTA2KSL FOREIGN KEY(ARTISTE_ID) REFERENCES PUBLIC.ARTISTE(ID),CONSTRAINT FKK7Q2MIX8LWV0L3EHVG0AL3OR1 FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID))
CREATE MEMORY TABLE PUBLIC.GESTIONNAIRE(AGE INTEGER NOT NULL,ID INTEGER NOT NULL PRIMARY KEY,GENRE VARCHAR(255),NOM VARCHAR(255),PERMISSION VARCHAR(255),PRENOM VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.TICKET(CLIENT_ID INTEGER,CONCERT_ID INTEGER,ID INTEGER NOT NULL PRIMARY KEY,PRIX INTEGER NOT NULL,UNIQUE(CLIENT_ID),UNIQUE(CONCERT_ID),CONSTRAINT FK43WDK3W5SF1OMWA8KBY7WX8CH FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.CLIENT(ID),CONSTRAINT FKIN9KJ2WIEJNS9PTUW1PT351KG FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID))
CREATE MEMORY TABLE PUBLIC.USER(AGE INTEGER NOT NULL,ID INTEGER NOT NULL PRIMARY KEY,GENRE VARCHAR(255),NOM VARCHAR(255),PRENOM VARCHAR(255))
ALTER TABLE PUBLIC.ARTISTE ADD CONSTRAINT FKNB0GTD8PDWD026Q3T68RCABNO FOREIGN KEY(CONCERT_ID) REFERENCES PUBLIC.CONCERT(ID)
ALTER TABLE PUBLIC.CLIENT ADD CONSTRAINT FKOMHJKXX1RE1A6R0J6EBC49873 FOREIGN KEY(TICKET_ID) REFERENCES PUBLIC.TICKET(ID)
